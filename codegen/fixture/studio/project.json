{
  "version": 1,
  "name": "Sample Metroidvania",
  "build": {
    "dev": "mkdir -p dist && cargo build && agb-gbafix target/thumbv4t-none-eabi/debug/sample -o dist/sample-dev.gba",
    "devRom": "dist/sample-dev.gba",
    "release": "mkdir -p dist && cargo build --release && agb-gbafix target/thumbv4t-none-eabi/release/sample -o dist/sample.gba",
    "releaseRom": "dist/sample.gba"
  },
  "collisionClasses": [
    {
      "id": "empty",
      "name": "Empty",
      "colour": "#000000",
      "kind": "empty"
    },
    {
      "id": "solid",
      "name": "Solid",
      "colour": "#e5484d",
      "kind": "solid"
    },
    {
      "id": "oneway",
      "name": "One-way platform",
      "colour": "#f5d90a",
      "kind": "oneway"
    },
    {
      "id": "slope-up",
      "name": "Slope up 45°",
      "colour": "#46a758",
      "kind": "slope",
      "slope": {
        "left": 0,
        "right": 8
      }
    },
    {
      "id": "slope-down",
      "name": "Slope down 45°",
      "colour": "#46a758",
      "kind": "slope",
      "slope": {
        "left": 8,
        "right": 0
      }
    },
    {
      "id": "hazard",
      "name": "Hazard",
      "colour": "#d6409f",
      "kind": "hazard"
    }
  ],
  "entityTypes": [
    {
      "id": "player-start",
      "name": "Player start",
      "colour": "#3e63dd",
      "sprite": "hero",
      "props": []
    },
    {
      "id": "sign",
      "name": "Sign",
      "colour": "#e5484d",
      "props": [
        {
          "name": "text",
          "type": "string",
          "default": "Hello"
        },
        {
          "name": "lit",
          "type": "bool",
          "default": false
        },
        {
          "name": "weight",
          "type": "int",
          "default": -3
        },
        {
          "name": "style",
          "type": "enum",
          "default": "wood",
          "options": [
            "wood",
            "stone"
          ]
        }
      ]
    }
  ]
}
