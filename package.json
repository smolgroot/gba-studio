{
  "name": "pecten-studio-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pecten-studio/server --filter @pecten-studio/app dev",
    "build": "pnpm --filter @pecten-studio/app build",
    "start": "node server/src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -b core server app",
    "sample:assets": "node scripts/make-sample-assets.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
